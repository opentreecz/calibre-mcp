# Copy to .env and fill in:   cp .env.example .env
#
# Content server account with write permission.
#
# NOTE: calibre's "allow unauthenticated local connections to make changes"
# does NOT help a container. The container arrives from the Docker bridge
# network (172.x.x.x), which calibre does not treat as a local connection,
# so writes are refused however that option is set. An account is required.
# Reads work without one, so the symptom only appears at the first write.
CALIBRE_USER=
CALIBRE_PASSWORD=

# digest (calibre's default) | basic (typical behind a reverse proxy) | none
CALIBRE_AUTH=digest

# 1 = read-only; recommended until you have tried the deployment out
CALIBRE_READONLY=1
