# Zkopíruj na .env a doplň vlastní hodnoty:  cp .env.example .env
#
# Uživatel Content Serveru s právem zápisu.
# POZOR: volba "Povolit neověřeným místním připojením provést změny"
# v Dockeru NEPOMŮŽE — kontejner přichází z bridge sítě (172.x.x.x)
# a Calibre ho za místní spojení nepovažuje. Účet je nutný.
CALIBRE_USER=
CALIBRE_PASSWORD=

# 1 = jen pro čtení (doporučeno, dokud si nasazení nevyzkoušíš)
CALIBRE_READONLY=1
